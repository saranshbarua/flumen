{
  "name": "flumen",
  "version": "2.0.0-staging.10",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:native": "swift test --package-path macos/Pomodoro",
    "test:mcp": "python3 scripts/mcp_stdio_smoke.py && python3 scripts/mcp_stdio_smoke.py --stub-app",
    "test:all": "npm test -- --run && npm run test:native && npm run test:mcp",
    "prepare": "husky",
    "release": "release-it",
    "release:staging": "release-it --config .release-it.staging.json --preRelease=staging",
    "commit": "cz"
  },
  "keywords": [
    "flumen",
    "macos",
    "focus timer",
    "pomodoro",
    "productivity",
    "flow state"
  ],
  "author": "Saransh Barua",
  "license": "ISC",
  "description": "Flumen is a minimalist focus timer for Mac. Glanceable, elegant, and built to keep you in flow.",
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@release-it/conventional-changelog": "^10.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "commitizen": "^4.3.1",
    "conventional-changelog-angular": "^8.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "release-it": "^19.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
